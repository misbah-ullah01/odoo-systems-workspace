<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- FORM VIEW — Compensating Control (standalone)                       -->
    <!-- ================================================================== -->
    <record id="view_exception_control_form" model="ir.ui.view">
        <field name="name">security.exception.control.form</field>
        <field name="model">security.exception.control</field>
        <field name="arch" type="xml">
            <form string="Compensating Control">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="control_type"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="exception_id"/>
                            <field name="responsible_id"/>
                            <field name="implementation_date"/>
                        </group>
                    </group>
                    <group string="Details">
                        <field name="description"
                               placeholder="Describe this compensating control..."/>
                        <field name="notes"
                               placeholder="Additional notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- LIST VIEW — Compensating Control (Odoo 19: <list> replaces <tree>)  -->
    <!-- ================================================================== -->
    <record id="view_exception_control_list" model="ir.ui.view">
        <field name="name">security.exception.control.list</field>
        <field name="model">security.exception.control</field>
        <field name="arch" type="xml">
            <list string="Compensating Controls" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="control_type"/>
                <field name="status"
                       widget="badge"
                       decoration-info="status == 'planned'"
                       decoration-warning="status == 'implemented'"
                       decoration-success="status == 'verified'"/>
                <field name="responsible_id"/>
                <field name="implementation_date"/>
                <field name="exception_id"/>
            </list>
        </field>
    </record>

</odoo>
