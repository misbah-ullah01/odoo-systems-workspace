# Odoo Configuration Example
# Copy this file and adjust for your environment.
# DO NOT commit the actual configuration with real credentials.

[options]
; Addons path — include this repo's addons directory
addons_path = /opt/odoo/addons,/opt/odoo/custom/addons

; Database settings
db_host = localhost
db_port = 5432
db_user = odoo
db_password = CHANGE_ME
db_name = odoo_dev

; Server settings
http_port = 8069
; xmlrpc_port is renamed to http_port in Odoo 19

; Logging
log_level = info
logfile = /var/log/odoo/odoo.log

; Security
admin_passwd = CHANGE_ME
list_db = False

; Workers (production)
; workers = 4
; max_cron_threads = 2
